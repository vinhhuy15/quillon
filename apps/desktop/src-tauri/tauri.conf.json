{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quillon",
  "version": "0.4.0",
  "identifier": "app.quillon.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Quillon",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Math editor and scientific figure toolkit",
    "longDescription": "Quillon is an open-source toolkit for researchers and students: an equation editor with Word/LaTeX export, drawing and diagrams, scientific symbol libraries, function plots and TikZ export.",
    "copyright": "Copyright © Quillon contributors. Apache-2.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["qln", "sci"],
        "name": "Quillon document",
        "description": "Quillon document",
        "mimeType": "application/x-quillon",
        "role": "Editor"
      }
    ]
  }
}
